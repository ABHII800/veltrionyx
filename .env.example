# Copy this file to .env and fill in your OWN values.
# .env is private. Never share it and never upload it to GitHub.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Local MySQL on your PC
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=veltrionyx_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# --- Only on the cloud server (set these in the Render dashboard) ---
# LIGHT_MODE=1
# MYSQL_SSL_CA=certifi
